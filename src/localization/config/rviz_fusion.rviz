Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15

    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR Scan
      Enabled: true
      Topic: /scan_fused
      Color Transformer: Intensity
      Style: Points
      Size (m): 0.03
      Queue Size: 10

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic: /odom
      Shape: Arrow
      Color: 255; 0; 0
      Alpha: 1
      Scale: 0.1

    - Class: rviz_default_plugins/IMU
      Name: IMU Orientation
      Enabled: true
      Topic: /imu/data_raw
      Color: 0; 255; 0
      Acceleration Arrow Scale: 0.5
      Orientation Arrow Scale: 0.5
      Axes Length: 0.5
      Axes Radius: 0.05
      Show Axes: true
      Show Acceleration: true

  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 0; 0; 0
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.785
      Yaw: 0.785
  Window Geometry:
    Height: 900
    Width: 1600
    X: 50
    Y: 50
